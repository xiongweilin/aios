# Copy to a deployment secret/config source. Never commit real values.
POSTGRES_USER=administrative
POSTGRES_PASSWORD=replace-with-secret
POSTGRES_DB=administrative

# Production identity. OIDC proves identity only; Administrative role and
# delegation state remains canonical in the Administrative authority plane.
ADMIN_OIDC_ISSUER=https://idp.example.com/realms/company
ADMIN_OIDC_AUDIENCE=administrative-orchestrator
ADMIN_OPERATIONS_OIDC_CLIENT_ID=administrative-operations-console
ADMIN_OPERATIONS_OIDC_SCOPE=openid profile email

# Odoo authoritative reader + World Runtime writer + independent verifier identities.
ADMIN_ODOO_BASE_URL=https://odoo.example.com
ADMIN_ODOO_DATABASE=company
ADMIN_ODOO_READER_USERNAME=administrative-reader
ADMIN_ODOO_READER_SECRET=replace-with-reader-secret
ADMIN_ODOO_WRITER_USERNAME=administrative-runtime-writer
ADMIN_ODOO_WRITER_SECRET=replace-with-writer-secret
ADMIN_ODOO_VERIFIER_USERNAME=administrative-runtime-verifier
ADMIN_ODOO_VERIFIER_SECRET=replace-with-verifier-secret
ADMIN_ODOO_FINANCIAL_WRITER_USERNAME=administrative-erp-writer
ADMIN_ODOO_FINANCIAL_WRITER_SECRET=replace-with-financial-writer-secret
ADMIN_ODOO_FINANCIAL_VERIFIER_USERNAME=administrative-erp-verifier
ADMIN_ODOO_FINANCIAL_VERIFIER_SECRET=replace-with-financial-verifier-secret
ADMIN_ODOO_REQUEST_REF_FIELD=x_administrative_request_ref
ADMIN_ODOO_TRANSACTION_REQUEST_REF_FIELD=x_administrative_transaction_request_ref
ADMIN_ODOO_TRANSACTION_CONFIRM_REQUEST_REF_FIELD=x_administrative_transaction_confirm_request_ref
ADMIN_ODOO_TRANSACTION_SUBJECT_REF_FIELD=x_administrative_transaction_subject_ref

# Keycloak reader + World Runtime writer + independent verifier service accounts.
ADMIN_KEYCLOAK_BASE_URL=https://idp.example.com
ADMIN_KEYCLOAK_REALM=company
ADMIN_KEYCLOAK_READER_CLIENT_ID=administrative-reader
ADMIN_KEYCLOAK_READER_SECRET=replace-with-reader-secret
ADMIN_KEYCLOAK_WRITER_CLIENT_ID=administrative-runtime-writer
ADMIN_KEYCLOAK_WRITER_SECRET=replace-with-writer-secret
ADMIN_KEYCLOAK_VERIFIER_CLIENT_ID=administrative-runtime-verifier
ADMIN_KEYCLOAK_VERIFIER_SECRET=replace-with-verifier-secret
ADMIN_KEYCLOAK_REQUEST_REF_ATTRIBUTE=administrative_request_ref

ADMIN_AUTHORITATIVE_FACT_MAX_AGE_SECONDS=300
ADMIN_CONNECTOR_TIMEOUT_SECONDS=10
ADMIN_WORKER_POLL_SECONDS=1
ADMIN_API_PORT=8000
ADMIN_OPERATIONS_CONSOLE_PORT=8080

# Optional M6 Feishu intake. Leave these blank until the provider, canonical
# read route, candidate-only model gateway, identity bindings, and staging
# acceptance evidence are ready. Secret values are never committed.
ADMIN_FEISHU_BASE_URL=https://open.feishu.cn
# Worker-only app credentials. The worker exchanges these for a short-lived
# tenant access token; they are not the ingress verification token.
ADMIN_FEISHU_APP_ID=
ADMIN_FEISHU_APP_SECRET=
# Optional worker-only file references for a mounted secret source. The
# process reads these paths directly; values are never copied into logs or
# durable intake records.
ADMIN_FEISHU_APP_ID_FILE=
ADMIN_FEISHU_APP_SECRET_FILE=
ADMIN_FEISHU_VERIFICATION_TOKEN=
ADMIN_FEISHU_ENCRYPT_KEY=
# Explicit test/manual override only; leave empty for staging/production.
ADMIN_FEISHU_ACCESS_TOKEN=
ADMIN_FEISHU_ARTIFACT_ROOT=/var/lib/administrative/intake-artifacts
# OpenAI-compatible route through the current local model gateway.
ADMIN_INTAKE_MODEL_PROTOCOL=openai-chat
ADMIN_INTAKE_MODEL_URL=
ADMIN_INTAKE_MODEL_API_KEY=
ADMIN_INTAKE_MODEL_NAME=
ADMIN_INTAKE_MODEL_MAX_TOKENS=2400

# Optional bounded investigation advisory boundary. Keep service and direct
# model credentials separate; blank URLs leave the path fail-closed.
ADMIN_INVESTIGATION_CLIENT_URL=
ADMIN_INVESTIGATION_CLIENT_API_KEY=
ADMIN_INVESTIGATION_CLIENT_API_KEY_FILE=
ADMIN_INVESTIGATION_MODEL_URL=
ADMIN_INVESTIGATION_MODEL_API_KEY=
ADMIN_INVESTIGATION_MODEL_API_KEY_FILE=
ADMIN_INVESTIGATION_MODEL_PROTOCOL=openai-chat
ADMIN_INVESTIGATION_MODEL_NAME=
ADMIN_INVESTIGATION_MODEL_MAX_TOKENS=2000
ADMIN_INVESTIGATION_MODEL_PROVIDER=configured-model-gateway
ADMIN_INVESTIGATION_MODEL_VERSION=configured
ADMIN_INVESTIGATION_MODEL_PROMPT_REF=adaptive-investigation-v1

# Break-glass initial bootstrap only. `{}` is a non-secret render placeholder so
# `docker compose config` can validate the bootstrap profile while it is inactive.
# Replace it only for the explicit one-shot `--profile bootstrap` invocation.
ADMIN_BOOTSTRAP_AUTHORITY_JSON={}
