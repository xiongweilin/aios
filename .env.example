# AIOS path and runtime configuration.
# Copy to .env and choose paths appropriate for the host/container runtime.

AIOS_CONTAINER_APP_ROOT=/opt/aios

AIOS_POSTGRES_USER=aios
AIOS_POSTGRES_PASSWORD=change-me
AIOS_POSTGRES_ADMIN_DSN=postgresql://aios:change-me@postgres:5432/postgres
AIOS_POSTGRES_DATABASES=personal_world,world_runtime,administrative,administrative_dbos,autodev,autodev_dbos
AIOS_HOST_POSTGRES_DATA_ROOT=./.aios-data/postgres
AIOS_CONTAINER_POSTGRES_DATA_ROOT=/data/postgres

PERSONAL_WORLD_DATABASE_URL=postgresql+psycopg://aios:change-me@postgres:5432/personal_world
PERSONAL_WORLD_HOST=0.0.0.0
PERSONAL_WORLD_PORT=8080

WORLD_RUNTIME_POSTGRES_DSN=postgresql://aios:change-me@postgres:5432/world_runtime
WORLD_RUNTIME_POSTGRES_SCHEMA=public
WORLD_RUNTIME_HOST=0.0.0.0
WORLD_RUNTIME_PORT=8086
WORLD_RUNTIME_ROOT_PRINCIPAL=human:owner

CONTROL_PLANE_HOST_DATA_ROOT=./.aios-data/control-plane
CONTROL_PLANE_DATA_ROOT=/data/control-plane
CONTROL_PLANE_STATE_DB=/data/control-plane/control-plane.db
CONTROL_PLANE_ARTIFACT_ROOT=/data/control-plane/artifacts
CONTROL_PLANE_AGENT_SESSION_DIR=/data/control-plane/agent-sessions
CONTROL_PLANE_AGENT_WORKTREE_ROOT=/data/control-plane/agent-worktrees
CONTROL_PLANE_GARBAGE_QUARANTINE_DIR=/data/control-plane/recovery-quarantine
CONTROL_PLANE_REMOTE_SHA_CACHE_PATH=/data/control-plane/remote-sha-cache.json
CONTROL_PLANE_API_KEY=local-aios
CONTROL_PLANE_WORLD_RUNTIME_BASE_URL=http://world-runtime:8086
CONTROL_PLANE_AGENT_BASE_URL=
CONTROL_PLANE_AGENT_EXECUTABLE=
CONTROL_PLANE_PROMETHEUS_URL=
CONTROL_PLANE_CHEZMOI_SOURCE_DIR=
CONTROL_PLANE_ENVIRONMENT_CHECKS=false
CONTROL_PLANE_NOTIFICATIONS=false

ADMIN_HOST_ARTIFACT_ROOT=./.aios-data/administrative/intake-artifacts
ADMIN_INTAKE_ARTIFACT_ROOT=/data/administrative/intake-artifacts
ADMIN_DATABASE_URL=postgresql+psycopg://aios:change-me@postgres:5432/administrative
ADMIN_WORKER_DATABASE_URL=postgresql+psycopg://aios:change-me@postgres:5432/administrative
ADMIN_DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://aios:change-me@postgres:5432/administrative_dbos
ADMIN_ALEMBIC_SCRIPT_LOCATION=/opt/aios/migrations/domains/administrative/alembic
ADMIN_RUNTIME_PROFILE=development
ADMIN_AUTH_MODE=development
ADMIN_WORLD_RUNTIME_MODE=disabled
ADMIN_AUTO_CREATE_SCHEMA=false
ADMIN_INTAKE_MODEL_URL=
ADMIN_INTAKE_MODEL_API_KEY=
ADMIN_INTAKE_MODEL_NAME=

AUTODEV_HOST_STATE_ROOT=./.aios-data/autonomous-development
AUTODEV_STATE_ROOT=/data/autonomous-development
AUTODEV_HOST_WORKSPACE_ROOT=.
AUTODEV_WORKSPACE_ROOT=/workspace
AUTODEV_HOST_DOCKER_SOCKET=/var/run/docker.sock
AUTODEV_DOCKER_SOCKET=/var/run/docker.sock
AUTODEV_DATABASE_URL=postgresql+psycopg://aios:change-me@postgres:5432/autodev
AUTODEV_DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://aios:change-me@postgres:5432/autodev_dbos
AUTODEV_ALEMBIC_SCRIPT_LOCATION=/opt/aios/migrations/domains/autonomous_development/alembic
AUTODEV_API_HOST=0.0.0.0
AUTODEV_API_PORT=8765
AUTODEV_WORLD_RUNTIME_MODE=disabled
AUTODEV_PERSONAL_WORLD_MODE=disabled
