{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xiongweilin/aios/blob/main/profiles/aios-profile.schema.json",
  "title": "AIOS Compatibility Profile",
  "description": "A tested, immutable composition of component-owner release artifacts. Each field preserves source ownership, version lineage, validation evidence, and permitted installation use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "validation", "compatibility", "components"],
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$", "description": "AIOS composition version; owned by xiongweilin/aios."},
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "completedAt", "evidenceUrl"],
      "properties": {
        "status": {"const": "passed"},
        "completedAt": {"type": "string", "format": "date-time"},
        "evidenceUrl": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["worldRuntimeProtocol", "semanticLanguage", "personalWorldContract", "domainControllerContract"],
      "properties": {
        "worldRuntimeProtocol": {"type": "string", "minLength": 1},
        "semanticLanguage": {"type": "string", "minLength": 1},
        "personalWorldContract": {"type": "string", "minLength": 1},
        "domainControllerContract": {"type": "string", "minLength": 1}
      }
    },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sourceRepository", "version", "releaseTag", "artifactUrl", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "sourceRepository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "description": "Authoritative component owner repository; AIOS does not copy component implementation."},
          "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
          "releaseTag": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
          "artifactUrl": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/.+/releases/download/"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$", "description": "Digest verified before extraction or replacement."}
        }
      }
    }
  }
}
